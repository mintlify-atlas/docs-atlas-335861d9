  "projectName": "Leantime",
  "projectDescription": "Leantime is an open-source, goals-focused project management system built for non-project managers, with accessibility features for ADHD, dyslexia, and autism.",
  "theme": "almond",
  "primaryColor": "#048ca4",
  "lightColor": "#488fb4",
  "darkColor": "#eff7f8",
